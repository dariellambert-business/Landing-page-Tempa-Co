---
// Web Tempa — Form Requirement Website
// Migrated from web-tempa.netlify.app to tempaco.id/web-tempa
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Web Tempa — Form Requirement Website</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#14171C;
    --surface:#1B1F26;
    --surface2:#222731;
    --border:#323A47;
    --text:#ECEEF0;
    --muted:#8B98A5;
    --accent:#C9963D;
    --accent-dim:#3D331C;
    --warn:#F2B84B;
  }
  [data-theme="light"]{
    --bg:#F7F5F1;
    --surface:#FFFFFF;
    --surface2:#F1EDE6;
    --border:#E0DACE;
    --text:#262320;
    --muted:#7A7468;
    --accent:#B07F2D;
    --accent-dim:#F1E2C4;
    --warn:#C98A1E;
  }
  body{transition:background .25s,color .25s;}
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    line-height:1.5;
    padding:40px 16px 80px;
  }
  .wrap{max-width:680px;margin:0 auto;}
  .topbar{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:18px;
  }
  .brand-logo{height:96px;width:auto;display:block;}
  .brand-logo--dark{display:none;}
  [data-theme="dark"] .brand-logo--light{display:none !important;}
  [data-theme="dark"] .brand-logo--dark{display:block !important;}
  [data-theme="light"] .brand-logo--light{display:block !important;}
  [data-theme="light"] .brand-logo--dark{display:none !important;}
  .theme-toggle{
    background:var(--surface2);border:1px solid var(--border);color:var(--text);
    border-radius:20px;padding:7px 14px;font-size:12.5px;cursor:pointer;
    font-family:'JetBrains Mono',monospace;transition:.2s;
  }
  .theme-toggle:hover{border-color:var(--accent);}

  /* Header — test case ticket style */
  .ticket{
    border:1px solid var(--border);
    border-radius:10px;
    background:var(--surface);
    padding:20px 22px;
    margin-bottom:28px;
  }
  .ticket-top{
    display:flex;justify-content:space-between;align-items:center;
    font-family:'JetBrains Mono',monospace;
    font-size:12px;color:var(--muted);
    margin-bottom:14px;
  }
  .status-badge{
    padding:3px 10px;border-radius:20px;
    background:var(--accent-dim);color:var(--accent);
    font-weight:600;letter-spacing:.04em;
    transition:.3s;
  }
  h1{
    font-size:22px;margin:0 0 4px;font-weight:700;letter-spacing:-.01em;
  }
  .subtitle{color:var(--muted);font-size:14px;margin:0;}

  .progress-row{
    display:flex;align-items:center;gap:10px;margin-top:16px;
    font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);
  }
  .progress-track{
    flex:1;height:6px;background:var(--surface2);border-radius:4px;overflow:hidden;
  }
  .progress-fill{
    height:100%;width:0%;background:var(--accent);transition:width .4s ease;
  }

  /* Sections styled as test steps */
  .step{
    border:1px solid var(--border);
    border-radius:10px;
    background:var(--surface);
    padding:18px 20px;
    margin-bottom:14px;
    position:relative;
    transition:border-color .25s;
  }
  .step.done{border-color:var(--accent);}
  .step-head{
    display:flex;align-items:center;gap:10px;margin-bottom:12px;
  }
  .step-num{
    width:22px;height:22px;border-radius:50%;
    background:var(--surface2);border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);
    flex-shrink:0;transition:.25s;
  }
  .step.done .step-num{background:var(--accent);border-color:var(--accent);color:#0F1419;}
  .step-title{font-weight:600;font-size:14.5px;}
  .step-hint{color:var(--muted);font-size:12px;margin:-6px 0 12px 32px;}

  label.field-label{
    display:block;font-size:12.5px;color:var(--muted);margin-bottom:6px;font-weight:500;
  }
  input[type=text],input[type=date],textarea,select{
    width:100%;
    background:var(--surface2);
    border:1px solid var(--border);
    color:var(--text);
    border-radius:7px;
    padding:10px 12px;
    font-size:14px;
    font-family:'Inter',sans-serif;
    margin-bottom:14px;
    transition:border-color .2s;
  }
  textarea{resize:vertical;min-height:64px;}
  input:focus,textarea:focus,select:focus{
    outline:none;border-color:var(--accent);
  }
  input::placeholder,textarea::placeholder{color:#566273;}

  .chip-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;}
  .chip{
    border:1px solid var(--border);background:var(--surface2);
    color:var(--text);border-radius:8px;padding:9px 14px;
    font-size:13px;cursor:pointer;user-select:none;
    display:flex;align-items:center;gap:6px;transition:.18s;
  }
  .chip:hover{border-color:#3a4656;}
  .chip.selected{
    border-color:var(--accent);background:var(--accent-dim);color:var(--accent);font-weight:600;
  }
  .chip .ic{font-size:14px;}

  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:520px){.two-col{grid-template-columns:1fr;}}
  .budget-desc{
    font-size:11.5px;color:var(--muted);margin:-10px 0 14px;line-height:1.5;
  }
  .note.rush-warn{
    color:#E2574C;background:rgba(226,87,76,.08);border-color:rgba(226,87,76,.3);
  }
  .note.rush-critical{
    color:#E2574C;background:rgba(226,87,76,.14);border-color:rgba(226,87,76,.5);font-weight:600;
  }

  .note{
    font-size:12px;color:var(--warn);
    background:rgba(242,184,75,.08);
    border:1px solid rgba(242,184,75,.25);
    border-radius:7px;padding:9px 11px;margin:-2px 0 14px;
    display:flex;gap:8px;align-items:flex-start;
  }
  .note span.ic{flex-shrink:0;}

  .upload-zone{
    border:1.5px dashed var(--border);
    border-radius:8px;padding:22px;text-align:center;
    color:var(--muted);font-size:13px;cursor:pointer;
    margin-bottom:6px;transition:.2s;
  }
  .upload-zone:hover{border-color:var(--accent);color:var(--accent);}
  .upload-zone input{display:none;}
  #file-list{font-size:12px;color:var(--muted);margin-bottom:8px;}

  .footer-note{
    font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--muted);
    text-align:center;margin:18px 0 22px;line-height:1.6;
  }

  .submit-btn{
    width:100%;padding:14px;border:none;border-radius:9px;
    background:var(--accent);color:#0F1419;font-weight:700;font-size:15px;
    cursor:pointer;transition:.2s;font-family:'Inter',sans-serif;
  }
  .submit-btn:hover{background:#b3812e;}
  .submit-btn:disabled{background:var(--surface2);color:var(--muted);cursor:not-allowed;}
  .consent-row{
    display:flex;align-items:flex-start;gap:10px;margin-bottom:14px;
    font-size:13px;color:var(--muted);cursor:pointer;line-height:1.5;
  }
  .consent-row input{
    margin-top:3px;width:16px;height:16px;accent-color:var(--accent);cursor:pointer;flex-shrink:0;
  }

  .result-banner{
    display:none;margin-top:14px;padding:12px 14px;border-radius:8px;
    background:var(--accent-dim);color:var(--accent);font-size:13px;
    font-family:'JetBrains Mono',monospace;text-align:center;
  }

  .summary-overlay{
    display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);
    z-index:999;align-items:flex-start;justify-content:center;
    padding:32px 16px;overflow-y:auto;
  }
  .summary-overlay.show{display:flex;}
  .summary-doc{
    background:var(--surface);border:1px solid var(--border);border-radius:12px;
    max-width:640px;width:100%;padding:32px;color:var(--text);
    font-family:'Inter',sans-serif;position:relative;
  }
  .close-x{
    position:absolute;top:14px;right:14px;width:30px;height:30px;
    border-radius:50%;border:1px solid var(--border);background:var(--surface2);
    color:var(--muted);font-size:18px;line-height:1;cursor:pointer;
    display:flex;align-items:center;justify-content:center;transition:.2s;
  }
  .close-x:hover{border-color:var(--accent);color:var(--accent);}
  .summary-doc h2{margin:0 0 4px;font-size:20px;}
  .summary-doc .doc-sub{color:var(--muted);font-size:12.5px;margin:0 0 20px;
    font-family:'JetBrains Mono',monospace;}
  .summary-row{
    display:flex;gap:16px;padding:10px 0;border-bottom:1px solid var(--border);
  }
  .summary-row:last-child{border-bottom:none;}
  .summary-label{
    flex:0 0 150px;font-size:12px;color:var(--muted);font-weight:600;
    text-transform:uppercase;letter-spacing:.03em;
  }
  .summary-value{flex:1;font-size:14px;white-space:pre-wrap;word-break:break-word;}
  .summary-actions{
    display:flex;gap:10px;margin-top:24px;
  }
  .summary-actions button{
    flex:1;padding:11px;border-radius:8px;border:1px solid var(--border);
    background:var(--surface2);color:var(--text);font-size:13px;cursor:pointer;
    font-family:'Inter',sans-serif;transition:.2s;
  }
  .summary-actions button.primary{
    background:var(--accent);color:#0F1419;border:none;font-weight:700;
  }
  .summary-actions button:hover{border-color:var(--accent);}
  @media print{
    body *{visibility:hidden;}
    .summary-doc, .summary-doc *{visibility:visible;}
    .summary-overlay{position:absolute;background:none;padding:0;}
    .summary-doc{box-shadow:none;border:none;max-width:100%;}
    .summary-actions{display:none;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <img src="/logo-web-tempa-light.png" alt="Web Tempa" class="brand-logo brand-logo--light" />
    <img src="/logo-web-tempa-dark.png" alt="Web Tempa" class="brand-logo brand-logo--dark" />
    <button id="theme-toggle" class="theme-toggle" aria-label="Ganti tema">🌙 Dark</button>
  </div>

  <div class="ticket">
    <div class="ticket-top">
      <span>WEB TEMPA · FORM-REQUIREMENT-001</span>
      <span class="status-badge" id="status-badge">DRAFT</span>
    </div>
    <h1>Web Tempa — Form Requirement Website</h1>
    <p class="subtitle">Tempa website, tempa bisnis. Isi detail kebutuhan kamu — makin lengkap, makin presisi hasil & estimasinya. ✅</p>
    <div class="progress-row">
      <span id="progress-text">0 / 8 terisi</span>
      <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
    </div>
  </div>

  <!-- Step 1: Contact -->
  <div class="step" data-step="contact">
    <div class="step-head"><div class="step-num">1</div><div class="step-title">Nama & kontak kamu</div></div>
    <p class="step-hint">Nama lengkap / nama bisnis, kontak aktif, dan lokasi bisnis</p>
    <input type="text" id="client-name" placeholder="Nama lengkap atau nama bisnis">
    <input type="text" id="contact" placeholder="0812xxxxxxxx atau email@domain.com">
    <div class="two-col">
      <div>
        <label class="field-label">WhatsApp bisnis (untuk dipasang di website)</label>
        <input type="text" id="wa-bisnis" placeholder="0812xxxxxxxx (nomor yang tampil di website)">
      </div>
      <div>
        <label class="field-label">Kota / area operasi bisnis</label>
        <input type="text" id="kota" placeholder="Contoh: Jakarta Selatan, Bandung, Surabaya">
      </div>
    </div>
    <div class="note"><span class="ic">⏱️</span> Respon WA biasanya dalam 1 hari kerja (di luar jam kerja kantor 9–18 WIB). Untuk follow-up cepat, sebut nama project di chat.</div>
  </div>

  <!-- Step 2: Jenis website -->
  <div class="step" data-step="jenis">
    <div class="step-head"><div class="step-num">2</div><div class="step-title">Jenis website</div></div>
    <div class="chip-grid" id="jenis-grid">
      <div class="chip" data-val="Landing page"><span class="ic">🚀</span>Landing page</div>
      <div class="chip" data-val="Company profile"><span class="ic">🏢</span>Company profile</div>
      <div class="chip" data-val="Undangan digital"><span class="ic">💌</span>Undangan digital</div>
      <div class="chip" data-val="Sales funnel"><span class="ic">📈</span>Sales funnel</div>
      <div class="chip" data-val="Portfolio"><span class="ic">🖼️</span>Portfolio</div>
      <div class="chip" data-val="Online course"><span class="ic">🎓</span>Online course</div>
      <div class="chip" data-val="Lainnya"><span class="ic">✏️</span>Lainnya (isi sendiri)</div>
    </div>
    <input type="text" id="jenis-lainnya" placeholder="Sebutkan jenis website yang kamu mau" style="display:none;">
  </div>

  <!-- Step 3: Profil Bisnis -->
  <div class="step" data-step="profil-bisnis">
    <div class="step-head"><div class="step-num">3</div><div class="step-title">Tentang bisnis kamu</div></div>
    <p class="step-hint">Info ini membantu AI kami menghasilkan konten website yang akurat & menjual</p>
    <label class="field-label">Bidang usaha spesifik</label>
    <input type="text" id="bidang-usaha" placeholder="Contoh: Skincare lokal, Jasa fotografi wedding, Kopi specialty, Klinik gigi">
    <label class="field-label">Ceritakan singkat bisnis kamu</label>
    <textarea id="deskripsi-bisnis" placeholder="Apa yang dijual/ditawarkan, siapa target pelanggannya? Contoh: Jualan hijab premium untuk wanita usia 25-40 yang cari bahan adem tapi tetap stylish"></textarea>
    <label class="field-label">Keunggulan utama (USP) — apa yang bikin beda dari kompetitor?</label>
    <textarea id="usp" placeholder="Contoh: Bahan premium tapi harga terjangkau, pengiriman same-day di Jabodetabek, garansi 30 hari uang kembali"></textarea>
  </div>

  <!-- Step 4: Tujuan -->
  <div class="step" data-step="tujuan">
    <div class="step-head"><div class="step-num">4</div><div class="step-title">Tujuan utama website ini</div></div>
    <textarea id="tujuan" placeholder="Contoh: Jualan produk skincare, kumpulkan leads, atau profil perusahaan untuk klien B2B"></textarea>
  </div>

  <!-- Step 5: Halaman -->
  <div class="step" data-step="halaman">
    <div class="step-head"><div class="step-num">5</div><div class="step-title">Halaman / section yang dibutuhkan</div></div>
    <textarea id="halaman" placeholder="Contoh: Home, Tentang Kami, Produk, Testimoni, Kontak"></textarea>
  </div>

  <!-- Step 6: Fitur tambahan -->
  <div class="step" data-step="fitur">
    <div class="step-head"><div class="step-num">6</div><div class="step-title">Fitur yang diinginkan</div></div>
    <p class="step-hint">Pilih fitur fungsional (boleh lebih dari satu) — beda dari halaman, ini soal fungsi teknis di website</p>
    <div class="chip-grid" id="fitur-grid">
      <div class="chip" data-val="Form kontak ke email/WA"><span class="ic">📩</span>Form kontak ke email/WA</div>
      <div class="chip" data-val="Galeri produk/foto"><span class="ic">🖼️</span>Galeri produk/foto</div>
      <div class="chip" data-val="Integrasi WA otomatis"><span class="ic">💬</span>Integrasi WA otomatis</div>
      <div class="chip" data-val="Payment gateway"><span class="ic">💳</span>Payment gateway</div>
      <div class="chip" data-val="Member login / akun"><span class="ic">🔐</span>Member login / akun</div>
      <div class="chip" data-val="Booking/jadwal online"><span class="ic">📅</span>Booking/jadwal online</div>
      <div class="chip" data-val="Multi-bahasa"><span class="ic">🌐</span>Multi-bahasa</div>
      <div class="chip" data-val="Belum tahu / tidak perlu"><span class="ic">➖</span>Belum tahu / tidak perlu</div>
    </div>
  </div>

  <!-- Step 7: Kesiapan konten -->
  <div class="step" data-step="konten">
    <div class="step-head"><div class="step-num">7</div><div class="step-title">Kesiapan konten (teks & foto)</div></div>
    <p class="step-hint">Ini menentukan estimasi waktu pengerjaan — konten yang belum siap butuh waktu tambahan</p>
    <div class="chip-grid" id="konten-grid">
      <div class="chip" data-val="Sudah siap semua"><span class="ic">✅</span>Sudah siap semua</div>
      <div class="chip" data-val="Sebagian siap"><span class="ic">🟡</span>Sebagian siap</div>
      <div class="chip" data-val="Belum sama sekali, perlu dibantu"><span class="ic">🆘</span>Belum sama sekali, perlu dibantu</div>
    </div>
    <div class="note"><span class="ic">📝</span> Kalau konten belum siap dan perlu dibantu (copywriting/foto), akan ada penyesuaian waktu & biaya tambahan yang dikonfirmasi saat follow-up.</div>
  </div>

  <!-- Step 8: Domain & hosting -->
  <div class="step" data-step="infra">
    <div class="step-head"><div class="step-num">8</div><div class="step-title">Domain & hosting</div></div>
    <div class="two-col">
      <div>
        <label class="field-label">Sudah ada domain?</label>
        <select id="domain"><option>Sudah ada</option><option>Belum, perlu dibantu beli</option><option>Belum perlu (pakai subdomain gratis)</option></select>
      </div>
      <div>
        <label class="field-label">Sudah ada hosting?</label>
        <select id="hosting"><option>Sudah ada</option><option>Belum, perlu dibantu beli</option><option>Belum tahu / butuh rekomendasi</option></select>
      </div>
    </div>
  </div>

  <!-- Step 9: Mood + referensi -->
  <div class="step" data-step="mood">
    <div class="step-head"><div class="step-num">9</div><div class="step-title">Referensi gaya / mood website</div></div>
    <div class="chip-grid" id="mood-grid">
      <div class="chip" data-val="Minimalis">Minimalis</div>
      <div class="chip" data-val="Elegan">Elegan</div>
      <div class="chip" data-val="Playful / colorful">Playful / colorful</div>
      <div class="chip" data-val="Korporat">Korporat</div>
      <div class="chip" data-val="Lainnya">Lainnya</div>
    </div>
    <div class="two-col">
      <div>
        <label class="field-label">Warna brand / warna favorit (jika ada)</label>
        <input type="text" id="warna-brand" placeholder="Contoh: biru navy & emas, hitam-putih, pastel pink">
      </div>
      <div>
        <label class="field-label">Sudah punya logo / branding?</label>
        <select id="has-branding"><option value="Belum ada">Belum ada</option><option value="Sudah ada logo">Sudah ada logo</option><option value="Sudah ada logo + brand guideline">Sudah ada logo + brand guideline</option></select>
      </div>
    </div>
    <label class="field-label">Link referensi website (jika ada)</label>
    <input type="text" id="ref-link" placeholder="https://contoh-website-yang-disuka.com">
  </div>

  <!-- Step 10: Budget & deadline -->
  <div class="step" data-step="budget">
    <div class="step-head"><div class="step-num">10</div><div class="step-title">Budget & deadline</div></div>
    <div class="two-col">
      <div>
        <label class="field-label">Budget</label>
        <select id="budget">
          <option value="Starter (Rp499rb – 1.2jt)">Starter (Rp499rb – 1.2jt)</option>
          <option value="Bisnis (Rp1.5jt – 2.5jt)">Bisnis (Rp1.5jt – 2.5jt)</option>
          <option value="Profesional (Rp3jt – 5jt)">Profesional (Rp3jt – 5jt)</option>
          <option value="Enterprise (Rp5jt+)">Enterprise (Rp5jt+)</option>
          <option value="Belum tahu - mau konsultasi dulu">Belum tahu - mau konsultasi dulu</option>
        </select>
        <p class="budget-desc" id="budget-desc"></p>
      </div>
      <div>
        <label class="field-label">Deadline diharapkan</label>
        <input type="date" id="deadline">
      </div>
    </div>
    <div class="note"><span class="ic">📌</span> Estimasi pengerjaan: <b>Starter 2–3 hari</b>, <b>Bisnis 4–6 hari</b>, <b>Profesional 6–10 hari kerja</b> setelah requirement & aset fix (di luar revisi). Maks <b>2x revisi minor</b> sudah termasuk harga; revisi besar/di luar scope dikenakan biaya tambahan.</div>
    <div class="note"><span class="ic">📦</span> Add-on opsional: Domain .com <b>+Rp150rb</b> · Hosting 1 tahun <b>+Rp300–500rb</b> · Copywriting penuh <b>+Rp500rb</b> · Maintenance bulanan <b>Rp100–150rb/bln</b></div>
    <div class="note"><span class="ic">💳</span> Skema pembayaran: <b>DP 50%</b> di awal sebelum pengerjaan dimulai, <b>sisa 50%</b> dibayar setelah website selesai & disetujui sebelum file/akses diserahkan.</div>
    <div class="note" id="rush-note" style="display:none;"></div>
  </div>

  <!-- Step 11: Logo / aset -->
  <div class="step" data-step="aset">
    <div class="step-head"><div class="step-num">11</div><div class="step-title">Logo / aset visual</div></div>
    <label class="upload-zone" for="file-input">⬆️ Upload logo, foto produk, atau dokumen pendukung lain (PDF/TXT/sitemap/referensi)<input type="file" id="file-input" multiple></label>
    <div id="file-list"></div>
  </div>

  <!-- Step 12: Catatan -->
  <div class="step" data-step="catatan">
    <div class="step-head"><div class="step-num">12</div><div class="step-title">Catatan tambahan</div></div>
    <textarea id="catatan" placeholder="Permintaan khusus lainnya bisa ditulis di sini"></textarea>
  </div>

  <label class="consent-row" for="consent-check">
    <input type="checkbox" id="consent-check">
    <span>Saya setuju dengan estimasi waktu, skema revisi, dan skema pembayaran (DP 50%) di atas.</span>
  </label>
  <button class="submit-btn" id="submit-btn" disabled>Kirim Requirement</button>
  <div class="result-banner" id="result-banner">✅ ALL CHECKS PASSED — Requirement siap dikirim. Terima kasih, kami akan follow-up sesuai estimasi respon di atas.</div>

  <div class="summary-overlay" id="summary-overlay">
    <div class="summary-doc" id="summary-doc">
      <button id="close-summary" class="close-x" aria-label="Tutup">&times;</button>
      <h2>Web Tempa — Ringkasan Requirement</h2>
      <p class="doc-sub" id="doc-date"></p>
      <div id="summary-rows"></div>
      <div class="summary-actions">
        <button id="copy-summary">Salin Teks</button>
        <button id="send-order" class="primary">Kirim Order</button>
        <button id="print-summary">Cetak / Simpan PDF</button>
      </div>
    </div>
  </div>

  <p class="footer-note">WEB TEMPA · QA-TESTED WORKFLOW · TEMPA WEBSITE, TEMPA BISNIS</p>
</div>

<script>
const selections = {jenis:new Set(), mood:new Set(), fitur:new Set(), konten:null};
document.querySelectorAll('#jenis-grid .chip').forEach(c=>{
  c.addEventListener('click',()=>{c.classList.toggle('selected');
    selections.jenis.has(c.dataset.val)?selections.jenis.delete(c.dataset.val):selections.jenis.add(c.dataset.val);
    document.getElementById('jenis-lainnya').style.display = selections.jenis.has('Lainnya') ? 'block' : 'none';
    updateProgress();});
});
document.querySelectorAll('#mood-grid .chip').forEach(c=>{
  c.addEventListener('click',()=>{c.classList.toggle('selected');
    selections.mood.has(c.dataset.val)?selections.mood.delete(c.dataset.val):selections.mood.add(c.dataset.val);
    updateProgress();});
});
document.querySelectorAll('#fitur-grid .chip').forEach(c=>{
  c.addEventListener('click',()=>{c.classList.toggle('selected');
    selections.fitur.has(c.dataset.val)?selections.fitur.delete(c.dataset.val):selections.fitur.add(c.dataset.val);
    updateProgress();});
});
document.querySelectorAll('#konten-grid .chip').forEach(c=>{
  c.addEventListener('click',()=>{
    document.querySelectorAll('#konten-grid .chip').forEach(o=>o.classList.remove('selected'));
    c.classList.add('selected');
    selections.konten = c.dataset.val;
    updateProgress();
  });
});

const fileInput = document.getElementById('file-input');
fileInput.addEventListener('change', ()=>{
  const names = Array.from(fileInput.files).map(f=>f.name).join(', ');
  document.getElementById('file-list').textContent = names ? '📎 '+names : '';
  updateProgress();
});

const trackedSteps = [
  {key:'contact', check:()=>document.getElementById('client-name').value.trim().length>1 && document.getElementById('contact').value.trim().length>3},
  {key:'jenis', check:()=>selections.jenis.size>0},
  {key:'profil-bisnis', check:()=>document.getElementById('bidang-usaha').value.trim().length>2 && document.getElementById('deskripsi-bisnis').value.trim().length>5},
  {key:'tujuan', check:()=>document.getElementById('tujuan').value.trim().length>3},
  {key:'halaman', check:()=>document.getElementById('halaman').value.trim().length>3},
  {key:'fitur', check:()=>true},
  {key:'konten', check:()=>!!selections.konten},
  {key:'infra', check:()=>true},
  {key:'mood', check:()=>selections.mood.size>0},
  {key:'budget', check:()=>document.getElementById('deadline').value.length>0},
  {key:'aset', check:()=>fileInput.files.length>0},
  {key:'catatan', check:()=>true},
];

['client-name','contact','wa-bisnis','kota','bidang-usaha','deskripsi-bisnis','usp','tujuan','halaman','deadline','jenis-lainnya','warna-brand'].forEach(id=>{
  document.getElementById(id).addEventListener('input', updateProgress);
});
document.getElementById('domain').addEventListener('change', updateProgress);
document.getElementById('hosting').addEventListener('change', updateProgress);
document.getElementById('has-branding').addEventListener('change', updateProgress);
document.getElementById('budget').addEventListener('change', updateProgress);
document.getElementById('catatan').addEventListener('input', updateProgress);
document.getElementById('consent-check').addEventListener('change', updateProgress);

const budgetDescriptions = {
  'Starter (Rp499rb – 1.2jt)': 'Landing page 1 halaman, custom-coded (bukan template), responsive, SEO dasar, CTA WhatsApp, 2x revisi minor. Pengerjaan 2–3 hari kerja.',
  'Bisnis (Rp1.5jt – 2.5jt)': 'Company profile 3–5 halaman, copywriting dibantu AI, desain disesuaikan brand, integrasi form/WA, SEO on-page. Pengerjaan 4–6 hari kerja.',
  'Profesional (Rp3jt – 5jt)': 'Website lengkap 6–10 halaman, custom design, blog, analytics setup, integrasi lanjutan (form ke email/WA otomatis, galeri produk). Revisi minor unlimited. Pengerjaan 6–10 hari kerja.',
  'Enterprise (Rp5jt+)': 'Sales funnel kompleks, member area, payment gateway, atau kebutuhan khusus lainnya. Scope besar — perlu diskusi detail dulu sebelum harga final.',
  'Belum tahu - mau konsultasi dulu': 'Santai — ceritakan kebutuhan kamu di catatan tambahan, kami bantu rekomendasikan paket yang pas.'
};
function updateBudgetDesc(){
  const val = document.getElementById('budget').value;
  document.getElementById('budget-desc').textContent = budgetDescriptions[val] || '';
}
document.getElementById('budget').addEventListener('change', updateBudgetDesc);
updateBudgetDesc();

// --- Rush fee algorithm ---
const tierMinDays = {
  'Starter (Rp499rb – 1.2jt)': 2,
  'Bisnis (Rp1.5jt – 2.5jt)': 4,
  'Profesional (Rp3jt – 5jt)': 6,
  'Enterprise (Rp5jt+)': null,
  'Belum tahu - mau konsultasi dulu': null
};
const tierLabel = {
  'Starter (Rp499rb – 1.2jt)': '2–3 hari kerja',
  'Bisnis (Rp1.5jt – 2.5jt)': '4–6 hari kerja',
  'Profesional (Rp3jt – 5jt)': '6–10 hari kerja'
};

function countWorkingDays(start, end){
  let count = 0;
  const d = new Date(start);
  d.setHours(0,0,0,0);
  const endDate = new Date(end);
  endDate.setHours(0,0,0,0);
  while(d < endDate){
    const day = d.getDay();
    if(day !== 0 && day !== 6) count++;
    d.setDate(d.getDate() + 1);
  }
  return count;
}

function updateRushNote(){
  const budgetVal = document.getElementById('budget').value;
  const deadlineVal = document.getElementById('deadline').value;
  const rushNote = document.getElementById('rush-note');
  const minDays = tierMinDays[budgetVal];

  if(!deadlineVal || minDays === null || minDays === undefined){
    rushNote.style.display = 'none';
    return;
  }

  const today = new Date();
  const deadlineDate = new Date(deadlineVal);
  const availableDays = countWorkingDays(today, deadlineDate);
  const deficit = minDays - availableDays;

  rushNote.classList.remove('rush-warn','rush-critical');

  if(availableDays <= 0){
    rushNote.classList.add('rush-critical');
    rushNote.innerHTML = '⚠️ Deadline yang diminta sangat mendesak (hari ini/sudah lewat hari kerja). Estimasi normal paket ini ' + tierLabel[budgetVal] + '. Mohon hubungi kami langsung untuk diskusi kelayakan & biaya tambahan.';
    rushNote.style.display = 'block';
  } else if(deficit > 0){
    const feePct = deficit >= 3 ? '50%' : '30%';
    rushNote.classList.add('rush-warn');
    rushNote.innerHTML = '⚠️ Deadline kamu hanya menyisakan <b>' + availableDays + ' hari kerja</b>, sementara estimasi normal paket ini <b>' + tierLabel[budgetVal] + '</b>. Kemungkinan ada <b>biaya rush +' + feePct + '</b> dari harga normal. Tim akan konfirmasi detail biaya saat follow-up.';
    rushNote.style.display = 'block';
  } else {
    rushNote.style.display = 'none';
  }
}
document.getElementById('budget').addEventListener('change', updateRushNote);
document.getElementById('deadline').addEventListener('change', updateRushNote);
updateRushNote();

function updateProgress(){
  let doneCount = 0;
  trackedSteps.forEach(s=>{
    const ok = s.check();
    const el = document.querySelector(`.step[data-step="${s.key}"]`);
    el.classList.toggle('done', ok);
    el.querySelector('.step-num').textContent = ok ? '✓' : el.querySelector('.step-num').dataset.n || el.dataset.numFallback || '';
  });
  // recompute numbers properly (since we overwrote with checkmarks)
  document.querySelectorAll('.step').forEach((el,i)=>{
    if(!el.classList.contains('done')) el.querySelector('.step-num').textContent = i+1;
  });
  // required for "filled" count: contact, jenis, tujuan, halaman, konten, mood, budget(deadline)
  const requiredKeys = ['contact','jenis','profil-bisnis','tujuan','halaman','konten','mood','budget'];
  let filled = 0;
  trackedSteps.forEach(s=>{ if(requiredKeys.includes(s.key) && s.check()) filled++; });
  const totalRequired = requiredKeys.length;
  document.getElementById('progress-text').textContent = `${filled} / ${totalRequired} terisi`;
  const pct = Math.round((filled/totalRequired)*100);
  document.getElementById('progress-fill').style.width = pct+'%';
  const badge = document.getElementById('status-badge');
  const submitBtn = document.getElementById('submit-btn');
  const consentChecked = document.getElementById('consent-check').checked;
  if(filled===totalRequired && consentChecked){
    badge.textContent='READY';
    submitBtn.disabled=false;
  } else {
    badge.textContent='DRAFT';
    submitBtn.disabled=true;
  }
}

function buildSummary(){
  const rows = [
    ['Nama / Bisnis', document.getElementById('client-name').value || '-'],
    ['Kontak', document.getElementById('contact').value || '-'],
    ['Jenis Website', (()=>{
      let vals = Array.from(selections.jenis);
      const lainnyaText = document.getElementById('jenis-lainnya').value.trim();
      if(vals.includes('Lainnya') && lainnyaText){
        vals = vals.filter(v=>v!=='Lainnya').concat(['Lainnya: '+lainnyaText]);
      }
      return vals.join(', ') || '-';
    })()],
    ['Bidang Usaha', document.getElementById('bidang-usaha').value || '-'],
    ['Deskripsi Bisnis', document.getElementById('deskripsi-bisnis').value || '-'],
    ['Keunggulan / USP', document.getElementById('usp').value || '-'],
    ['WA Bisnis (untuk website)', document.getElementById('wa-bisnis').value || '-'],
    ['Kota / Area', document.getElementById('kota').value || '-'],
    ['Tujuan Utama', document.getElementById('tujuan').value || '-'],
    ['Halaman / Section', document.getElementById('halaman').value || '-'],
    ['Fitur Diinginkan', Array.from(selections.fitur).join(', ') || '-'],
    ['Kesiapan Konten', selections.konten || '-'],
    ['Domain', document.getElementById('domain').value],
    ['Hosting', document.getElementById('hosting').value],
    ['Mood / Gaya', Array.from(selections.mood).join(', ') || '-'],
    ['Warna Brand', document.getElementById('warna-brand').value || '-'],
    ['Branding Existing', document.getElementById('has-branding').value],
    ['Referensi Link', document.getElementById('ref-link').value || '-'],
    ['Budget', document.getElementById('budget').value],
    ['Deadline', document.getElementById('deadline').value || '-'],
    ['Skema Pembayaran', 'DP 50% di awal, sisa 50% setelah selesai & disetujui'],
    ['Aset Terlampir', fileInput.files.length ? Array.from(fileInput.files).map(f=>f.name).join(', ') : 'Tidak ada'],
    ['Catatan Tambahan', document.getElementById('catatan').value || '-'],
    ['Estimasi Rush Fee', document.getElementById('rush-note').style.display === 'block' ? document.getElementById('rush-note').textContent.trim() : 'Tidak ada (deadline sesuai estimasi normal)'],
  ];
  const container = document.getElementById('summary-rows');
  container.innerHTML = '';
  rows.forEach(([label, value])=>{
    const row = document.createElement('div');
    row.className = 'summary-row';
    row.innerHTML = `<div class="summary-label">${label}</div><div class="summary-value"></div>`;
    row.querySelector('.summary-value').textContent = value;
    container.appendChild(row);
  });
  const now = new Date();
  document.getElementById('doc-date').textContent =
    'Dibuat ' + now.toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'}) +
    ' · ' + now.toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'});
  return rows;
}

function summaryToText(rows){
  return 'WEB TEMPA — RINGKASAN REQUIREMENT\n' + '='.repeat(34) + '\n\n' +
    rows.map(([label, value]) => label + ':\n' + value).join('\n\n');
}

document.getElementById('submit-btn').addEventListener('click', ()=>{
  document.getElementById('result-banner').style.display='block';
  document.getElementById('submit-btn').textContent='Terkirim ✓';
  document.getElementById('submit-btn').disabled=true;
  const rows = buildSummary();
  document.getElementById('summary-overlay').classList.add('show');
  document.getElementById('summary-overlay').dataset.rowsText = summaryToText(rows);
});

document.getElementById('close-summary').addEventListener('click', ()=>{
  document.getElementById('summary-overlay').classList.remove('show');
});

document.getElementById('print-summary').addEventListener('click', ()=>{
  window.print();
});

document.getElementById('send-order').addEventListener('click', async ()=>{
  const btn = document.getElementById('send-order');
  const originalText = btn.textContent;

  // ── Kumpulkan data form ke JSON ──
  const jenisVals = Array.from(selections.jenis || []);
  const lainnyaText = document.getElementById('jenis-lainnya').value.trim();
  const jeниsFinal = jenisVals.includes('Lainnya') && lainnyaText
    ? jenisVals.filter(v=>v!=='Lainnya').concat(['Lainnya: '+lainnyaText])
    : jenisVals;

  const deadlineVal = document.getElementById('deadline').value || null;
  const isRush = document.getElementById('rush-note').style.display === 'block';

  const payload = {
    nama_bisnis:        document.getElementById('client-name').value || '',
    kontak:             document.getElementById('contact').value || '',
    wa_bisnis:          document.getElementById('wa-bisnis').value || '',
    kota:               document.getElementById('kota').value || '',
    tipe_bisnis:        jeниsFinal.join(', '),
    bidang_usaha:       document.getElementById('bidang-usaha').value || '',
    deskripsi_bisnis:   document.getElementById('deskripsi-bisnis').value || '',
    usp:                document.getElementById('usp').value || '',
    tujuan_website:     document.getElementById('tujuan').value || '',
    halaman_dibutuhkan: document.getElementById('halaman').value || '',
    fitur:              Array.from(selections.fitur || []).join(', '),
    kesiapan_konten:    selections.konten || '',
    domain:             document.getElementById('domain').value,
    hosting:            document.getElementById('hosting').value,
    tone_dan_gaya:      Array.from(selections.mood || []).join(', '),
    warna_brand:        document.getElementById('warna-brand').value || '',
    branding_existing:  document.getElementById('has-branding').value,
    referensi_desain:   document.getElementById('ref-link').value || '',
    budget:             document.getElementById('budget').value,
    deadline:           deadlineVal,
    rush_project:       isRush,
    aset_file:          Array.from(fileInput.files || []).map(f=>f.name).join(', '),
    catatan_tambahan:   document.getElementById('catatan').value || '',
    tanggal_masuk:      new Date().toISOString(),
    source:             'Web Tempa Form'
  };

  // ── Kirim ke n8n webhook ──
  const WEBHOOK_URL = 'https://hook.us2.make.com/2uvsyj7vp7lzb6wh384jnqtyrhlawa9j';

  btn.textContent = 'Mengirim...';
  btn.disabled = true;

  try {
    const res = await fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (!res.ok) throw new Error('HTTP ' + res.status);

    btn.textContent = '✅ Terkirim!';
    btn.style.background = '#2d8a4e';

    // Notif WA tetap jalan setelah data berhasil masuk
    const text = document.getElementById('summary-overlay').dataset.rowsText || '';
    const phone = '62895806680374';
    const waUrl = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(
      '🔔 *ORDER BARU MASUK — Web Tempa*\n\n' +
      'Nama: ' + payload.nama_bisnis + '\n' +
      'Kontak: ' + payload.kontak + '\n' +
      'Budget: ' + payload.budget + '\n' +
      'Deadline: ' + (payload.deadline || '-') + '\n\n' +
      '✅ Data sudah tersimpan di Notion.'
    );
    setTimeout(()=>{ window.open(waUrl, '_blank'); }, 800);

  } catch(err) {
    console.error('Webhook error:', err);
    btn.textContent = '⚠️ Gagal kirim ke server';
    btn.style.background = '#c0392b';

    // Fallback: kirim via WA kalau webhook gagal
    setTimeout(()=>{
      btn.textContent = 'Kirim via WA (fallback)';
      btn.style.background = '';
      btn.disabled = false;
      btn.onclick = ()=>{
        const text = document.getElementById('summary-overlay').dataset.rowsText || '';
        const phone = '62895806680374';
        window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(text), '_blank');
      };
    }, 2000);
  }
});

document.getElementById('copy-summary').addEventListener('click', async ()=>{
  const text = document.getElementById('summary-overlay').dataset.rowsText || '';
  const btn = document.getElementById('copy-summary');
  const original = btn.textContent;
  function showCopied(){
    btn.textContent = 'Tersalin ✓';
    setTimeout(()=>{ btn.textContent = original; }, 1500);
  }
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(text);
      showCopied();
      return;
    }
    throw new Error('Clipboard API tidak tersedia');
  }catch(e){
    try{
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      if(ok){ showCopied(); return; }
      throw new Error('execCommand gagal');
    }catch(e2){
      alert('Gagal menyalin otomatis (kemungkinan dibatasi browser/preview). Silakan blok teks dokumen secara manual lalu salin (Ctrl+C / Cmd+C).');
    }
  }
});

const themeBtn = document.getElementById('theme-toggle');
const root = document.documentElement;
function applyTheme(t){
  root.setAttribute('data-theme', t);
  themeBtn.textContent = t === 'light' ? '☀️ Light' : '🌙 Dark';
  localStorage.setItem('webtempa-theme', t);
}
const savedTheme = localStorage.getItem('webtempa-theme') || 'dark';
applyTheme(savedTheme);
themeBtn.addEventListener('click', ()=>{
  const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
  applyTheme(next);
});

updateProgress();
</script>
